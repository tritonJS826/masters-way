#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

WEBAPP="mw-webapp/"
SERVER="mw-server/"
CHAT_WEBSOCKEt="mw-chat-websocket/"
NOTIFICATION_WEBSOCKET="mw-notification-websocket/"
TEST_WEBSOCKEt="mw-test-websocket"

generateSwaggerDocs () {
  pnpm swag
}

generateDbSchemas () {
  pnpm db:generate
}

preventUncommitedChanges () {
  # Check for uncommitted changes
  git diff --exit-code
  if [ $? -ne 0 ]; then
    echo "Changes detected after running swag. Please add the generated files before committing."
    exit 1
  fi
}

runWebappIfChanged () {
  if git diff --name-only --cached | grep "$WEBAPP"
  then
    echo "webapp changed. checking..."
    pnpm web:lint-staged
    pnpm concurrently \
        "pnpm web:type-check" \
        "pnpm web:test" \
        "pnpm web:build-storybook" \
        "pnpm web:build" \
        "pnpm web:cypress:component:run"
  fi
}

runServerIfChanged () {
  if git diff --name-only --cached | grep "$SERVER"
  then
    echo "mw-server changed. checking..."
    pnpm server:build
    pnpm server:test
  fi
}

runChatWebsocketIfChanged () {
  if git diff --name-only --cached | grep "$CHAT_WEBSOCKEt"
  then
    echo "mw-chat-websocket changed. checking..."
    pnpm chat-websocket:build
    pnpm server:test
  fi
}

runNotificationWebsocketIfChanged () {
  if git diff --name-only --cached | grep "$NOTIFICATION_WEBSOCKET"
  then
    echo "mw-notification-websocket changed. checking..."
    pnpm notification-websocket:build
    pnpm notification-websocket:test
  fi
}

runTestWebsocketIfChanged () {
  if git diff --name-only --cached | grep "$TEST_WEBSOCKEt"
  then
    echo "mw-test-websocket changed. checking..."
    pnpm test-websocket:build
    pnpm server:test
  fi
}

runE2E () {
  pnpm web:cypress:e2e:run
}

generateSwaggerDocs
generateDbSchemas

preventUncommitedChanges

# integration and module tests
runWebappIfChanged
runServerIfChanged
runChatWebsocketIfChanged
runNotificationWebsocketIfChanged
runTestWebsocketIfChanged

# e2e tests
runE2E